{
  "$schema": "habot.design-tokens/v1",
  "meta": {
    "library_name": "habot_design_system",
    "library_version": "0.1.0",
    "library_location_path": "lib/design_system",
    "spec_source": "My stepsFN06082026.xlsx :: Fredrick sheet",
    "covers_atomic_steps": [
      "TTMCS-001-A01",
      "RCGLA-001-A01",
      "TTMCS-004-A01",
      "TTMCS-005-A01",
      "SSTLA-004-A01",
      "RCGLA-012-A01",
      "RCGLA-032-A01",
      "RCGLA-018-A01",
      "ANSA-012-A01",
      "TTMAC-011-A01",
      "BPTR-0422-A01",
      "REF-377-A01",
      "BPTR-0128-A01",
      "TTMAC-014-A01",
      "CSIVW-001-A01",
      "IS12-CSIVW-011-AS01-A01",
      "IS02-CSIVW-005-AS01-A01",
      "BPTR-0160-A01",
      "REF-197-A01",
      "FIEVR-033-A01",
      "GEN-00055-A01",
      "GEN-00954-A01",
      "GEN-00235-A01",
      "MUFCE-028-A01",
      "GEN-01363-A01",
      "GEN-01848-A01",
      "GEN-01297-A01",
      "GEN-01275-A01",
      "GEN-01452-A01",
      "GEN-00201-A01",
      "IS38-SGTIM-018-AS01-A01",
      "CPNCA-006-A01",
      "ANSA-006-A01",
      "UFHT-032-A01",
      "GEN-00632-A01",
      "SSTLA-012-A01",
      "GEN-03270-A01",
      "SSTLA-010-A01",
      "SSTLA-018-A01",
      "GEN-02334-A01",
      "GEN-02676-A01",
      "GEN-00999-A01",
      "GEN-02082-A01",
      "GEN-01474-A01",
      "GEN-00022-A01",
      "GEN-02060-A01",
      "GEN-02720-A01",
      "GEN-03437-A01",
      "IS22-RCGLA-022-AS01-A01",
      "GEN-03404-A01"
    ],
    "brand_signoff_status": "PROVISIONAL",
    "brand_signoff_note": "RCGLA-001 'Decision to be Made Before Setup Step' = exact primary corporate theme colors. Awaiting brand sign-off. Every value below is WCAG-audited and structurally correct; swapping the hex values re-runs the same gates with zero code change."
  },

  "grid": {
    "baseline_dp": 8,
    "sub_baseline_dp": 4,
    "compact_columns": 4,
    "medium_columns": 8,
    "expanded_columns": 12,
    "outer_margin_dp": 16,
    "gutter_dp": 16,
    "vertical_rhythm_dp": 8,
    "breakpoint_xs_dp": 0,
    "breakpoint_sm_dp": 600,
    "breakpoint_md_dp": 840,
    "breakpoint_compact_dp": 0,
    "breakpoint_medium_dp": 600,
    "breakpoint_expanded_dp": 840,
    "navigation_collapse_dp": 768,
    "min_supported_width_dp": 320,
    "max_hardcoded_wrapper_width_dp": 360,
    "max_compact_segments": 4,
    "_gutter_note": "gutter_dp is the COLUMN gutter (RCGLA-032, named explicitly). vertical_rhythm_dp is the baseline step (RCGLA-012, 'continuous 8px vertical rhythm'). See device_matrix.json -> decision_record.conflict_resolved."
  },

  "motion": {
    "_source": "BPTR-0422 (passive failure motion curves) + REF-377 (progressive stepper transitions). Both write to the Motion & Animation System library.",
    "failure_duration_ms": 300,
    "failure_dim_opacity": 0.32,
    "failure_locks_surrounding_ui": true,
    "failure_auto_scroll_duration_ms": 300,
    "failure_auto_scroll_enabled": true,
    "failure_pulse_period_ms": 1200,
    "failure_pulse_min_opacity": 0.55,
    "failure_pulse_max_opacity": 1.0,
    "stepper_slide_in_ms": 200,
    "stepper_slide_out_ms": 160,
    "instant_ms": 0,
    "fast_ms": 100,
    "standard_ms": 200,
    "emphasized_ms": 300,
    "slow_ms": 500,
    "interactive_ceiling_ms": 200,
    "sheet_enter_ms": 200,
    "sheet_exit_ms": 160,
    "sheet_snap_ms": 100,
    "snackbar_display_ms": 4000,
    "snackbar_display_with_action_ms": 6000,
    "shared_axis_ms": 300,
    "search_debounce_ms": 300,
    "search_latency_budget_ms": 350,
    "hesitation_dwell_ms": 2000,
    "double_tap_window_ms": 300,
    "poll_interval_ms": 30000,
    "poll_timeout_ms": 10000,
    "navigation_surface_swap_ms": 100,
    "preference_render_floor_ms": 100,
    "preference_render_optimal_ms": 30,
    "reduced_motion": "Honoured via MediaQuery.disableAnimations (the Flutter equivalent of prefers-reduced-motion). Every design-system animation routes through HabotMotionPolicy.resolve."
  },

  "shell": {
    "_source": "SSTLA-012 (Contextual Mirror blueprint), GEN-03270 (split-screen and master-detail containers), SSTLA-010 (pane distribution and pinned metrics), SSTLA-018 (5.5-inch dashboard grid), GEN-00022 (dashboard stacking).",
    "mirror_min_pane_extent_dp": 160,
    "mirror_divider_thickness_dp": 1,
    "mirror_pane_padding_dp": 16,
    "mirror_panel_bar_height_dp": 48,
    "mirror_split_ratios": { "action_heavy": 0.35, "balanced": 0.50, "evidence_heavy": 0.65 },
    "master_detail_master_flex": 35,
    "master_detail_detail_flex": 65,
    "pane_max_line_length_chars": 75,
    "pinned_metrics_max": 4,
    "reference_viewport_px": { "width": 1080, "height": 1920, "device_pixel_ratio": 3 },
    "reference_viewport_dp": { "width": 360, "height": 640 },
    "dashboard_single_column": 1,
    "dashboard_quad_columns": 2,
    "thumb_zone_fraction": 0.33
  },

  "navigation": {
    "_source": "GEN-02334 (rails and bottom bars), GEN-02676 (unread badge), GEN-00999 (deep link context), GEN-02082 (route table), GEN-01474 (tab-switch budget).",
    "rail_width_dp": 80,
    "bottom_bar_height_dp": 72,
    "max_bottom_bar_destinations": 5,
    "badge_max_count": 99,
    "tab_switch_ceiling_ms": 200,
    "max_remembered_routes": 16
  },

  "connectivity": {
    "_source": "GEN-02720 (offline state machine), GEN-03437 (offline banner).",
    "poll_interval_ms": 30000,
    "poll_timeout_ms": 10000,
    "failures_before_offline": 2,
    "successes_before_online": 1,
    "banner_contrast_floor": 4.5,
    "banner_contrast_optimal": 7.0
  },

  "preferences": {
    "_source": "IS22-RCGLA-022 (preference manager panel), GEN-03404 (notification preference screen).",
    "columns": ["allow_promo", "allow_transaction"],
    "row_min_height_dp": 48,
    "write_before_transition": true,
    "render_budget_ms": 100,
    "render_optimal_ms": 30
  },

  "surfaces": {
    "_source": "GEN-00055 (BottomSheet atomic component), GEN-00954 (MD3 bottom-sheet standardisation), GEN-00235 (default snapping point), GEN-01452 (card chassis).",
    "sheet_top_corner_radius_dp": 28,
    "sheet_drag_handle_width_dp": 32,
    "sheet_drag_handle_height_dp": 4,
    "sheet_drag_handle_top_margin_dp": 12,
    "sheet_content_padding_dp": 16,
    "sheet_content_gap_dp": 12,
    "sheet_default_snap_fraction": 0.60,
    "sheet_min_snap_fraction": 0.30,
    "sheet_max_snap_fraction": 0.95,
    "sheet_scrim_opacity": 0.32,
    "sheet_scrim_hex": "#000000",
    "sheet_elevation_level": 1,
    "sheet_min_usable_height_dp": 240,
    "card_corner_radius_dp": 12,
    "card_content_padding_dp": 16,
    "card_border_width_dp": 1,
    "card_elevation_level": { "filled": 0, "outlined": 0, "elevated": 1 },
    "card_has_border": { "filled": false, "outlined": true, "elevated": false }
  },

  "feedback": {
    "_source": "GEN-01363 (error snackbars), GEN-01848 (progress indicators), GEN-01297 (empty state), GEN-01275 (status badges).",
    "snackbar_corner_radius_dp": 4,
    "snackbar_horizontal_margin_dp": 16,
    "snackbar_vertical_margin_dp": 8,
    "snackbar_max_lines": 2,
    "progress_track_height_dp": 4,
    "progress_corner_radius_dp": 4,
    "progress_spinner_size_dp": 32,
    "progress_spinner_stroke_dp": 4,
    "empty_state_icon_size_dp": 64,
    "empty_state_max_content_width_dp": 320,
    "empty_state_gap_dp": 12,
    "badge_dot_size_dp": 8,
    "badge_labelled_height_dp": 16,
    "badge_horizontal_padding_dp": 4,
    "badge_icon_size_dp": 12
  },

  "discovery": {
    "_source": "CPNCA-006 (list virtualisation and chunking), ANSA-006 (expandable header search).",
    "chunk_size": 20,
    "prefetch_threshold": 5,
    "max_materialised_items": 60,
    "recent_search_limit": 8,
    "min_query_length": 2,
    "search_result_row_height_dp": 48,
    "max_visible_results": 6
  },

  "telemetry": {
    "_source": "UFHT-032 (UI hesitation tracker engine), GEN-00632 (mobile UX friction logs).",
    "hesitation_dwell_ms": 2000,
    "double_tap_window_ms": 300,
    "poll_interval_ms": 30000,
    "poll_timeout_ms": 10000,
    "navigation_surface_swap_ms": 100,
    "preference_render_floor_ms": 100,
    "preference_render_optimal_ms": 30,
    "event_listener_coverage_floor_pct": 95.0,
    "event_listener_coverage_optimal_pct": 99.0,
    "double_tap_correction_ceiling_pct": 1.0,
    "scrub_before_emit": true,
    "record_field_values": false
  },

  "forms": {
    "_source": "CSIVW-001, IS12-CSIVW-011, IS02-CSIVW-005, BPTR-0160, FIEVR-033",
    "max_field_length_default": 255,
    "max_paste_length": 255,
    "error_text_style": "bodySmall",
    "error_text_size_sp": 12,
    "error_text_line_height_sp": 16,
    "helper_text_style": "bodySmall",
    "clear_icon_min_target_dp": 48,
    "revalidate_on_edit": true,
    "strip_trailing_whitespace_on_paste": true,
    "reject_non_ascii_paste": true,
    "compound_field_min_target_dp": 48,
    "stepper_progress_dot_dp": 8,
    "stepper_progress_dot_active_dp": 24,
    "stepper_progress_dot_gap_dp": 8
  },

  "spacing": {
    "none": 0,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 40,
    "xxxl": 48
  },

  "density": {
    "_metric": "Material Design Density Compliance (dp) -- TTMCS-004",
    "floor_padding_dp": 4,
    "optimal_padding_min_dp": 6,
    "optimal_padding_max_dp": 8,
    "ceiling_padding_dp": 12,
    "dense_row_padding_dp": 8,
    "optimal_row_height_min_dp": 32,
    "optimal_row_height_max_dp": 48,
    "dense_row_height_dp": 40,
    "min_touch_target_dp": 48,
    "touch_safety_margin_dp": 8,
    "app_bar_height_dp": 64,
    "max_header_title_chars": 28
  },

  "shape": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 28,
    "full": 999,
    "border_width_dp": 1,
    "focus_border_width_dp": 2
  },

  "elevation": {
    "level0_dp": 0,
    "level1_dp": 1,
    "level2_dp": 3,
    "level3_dp": 6,
    "level4_dp": 8,
    "level5_dp": 12,
    "dark_overlay_alpha": {
      "level0": 0.0,
      "level1": 0.05,
      "level2": 0.08,
      "level3": 0.11,
      "level4": 0.12,
      "level5": 0.14
    },
    "dark_surface_ladder": {
      "level0": "#101416",
      "level1": "#171D22",
      "level2": "#1B2329",
      "level3": "#1F2830",
      "level4": "#212A32",
      "level5": "#232E37"
    }
  },

  "typography": {
    "font_name": "Roboto",
    "font_file_path": "platform-bundled (Flutter default Material type face); no external asset required",
    "scale": {
      "displayLarge":  { "size_sp": 57, "line_height_sp": 64, "weight": 400, "tracking": -0.25 },
      "displayMedium": { "size_sp": 45, "line_height_sp": 52, "weight": 400, "tracking": 0 },
      "displaySmall":  { "size_sp": 36, "line_height_sp": 44, "weight": 400, "tracking": 0 },
      "headlineLarge": { "size_sp": 32, "line_height_sp": 40, "weight": 400, "tracking": 0 },
      "headlineMedium":{ "size_sp": 28, "line_height_sp": 36, "weight": 400, "tracking": 0 },
      "headlineSmall": { "size_sp": 24, "line_height_sp": 32, "weight": 400, "tracking": 0 },
      "titleLarge":    { "size_sp": 22, "line_height_sp": 28, "weight": 400, "tracking": 0 },
      "titleMedium":   { "size_sp": 16, "line_height_sp": 24, "weight": 500, "tracking": 0.15 },
      "titleSmall":    { "size_sp": 14, "line_height_sp": 20, "weight": 500, "tracking": 0.1 },
      "bodyLarge":     { "size_sp": 16, "line_height_sp": 24, "weight": 400, "tracking": 0.5 },
      "bodyMedium":    { "size_sp": 14, "line_height_sp": 20, "weight": 400, "tracking": 0.25 },
      "bodySmall":     { "size_sp": 12, "line_height_sp": 16, "weight": 400, "tracking": 0.4 },
      "labelLarge":    { "size_sp": 14, "line_height_sp": 20, "weight": 500, "tracking": 0.1 },
      "labelMedium":   { "size_sp": 12, "line_height_sp": 16, "weight": 500, "tracking": 0.5 },
      "labelSmall":    { "size_sp": 11, "line_height_sp": 16, "weight": 500, "tracking": 0.5 }
    }
  },

  "color": {
    "seed": {
      "primary": "#00629B",
      "secondary": "#00696E",
      "tertiary": "#6B5778"
    },
    "light": {
      "primary": "#00538A", "onPrimary": "#FFFFFF",
      "primaryContainer": "#CDE5FF", "onPrimaryContainer": "#001D33",
      "secondary": "#00565B", "onSecondary": "#FFFFFF",
      "secondaryContainer": "#B0ECF1", "onSecondaryContainer": "#00201F",
      "tertiary": "#5A4666", "onTertiary": "#FFFFFF",
      "tertiaryContainer": "#F0DBFF", "onTertiaryContainer": "#231531",
      "error": "#B3261E", "onError": "#FFFFFF",
      "errorContainer": "#F9DEDC", "onErrorContainer": "#410E0B",
      "surface": "#FAFCFF", "onSurface": "#1A1C1E", "onSurfaceVariant": "#41474D",
      "surfaceContainerLowest": "#FFFFFF", "surfaceContainerLow": "#F2F6FA",
      "surfaceContainer": "#ECF0F5", "surfaceContainerHigh": "#E6EAEF",
      "surfaceContainerHighest": "#E0E4EA",
      "outline": "#71787E", "outlineVariant": "#C1C7CE",
      "inverseSurface": "#2E3133", "onInverseSurface": "#F0F1F4"
    },
    "dark": {
      "primary": "#9BCBFF", "onPrimary": "#003353",
      "primaryContainer": "#004A76", "onPrimaryContainer": "#CDE5FF",
      "secondary": "#8ED0D5", "onSecondary": "#00363A",
      "secondaryContainer": "#004F53", "onSecondaryContainer": "#B0ECF1",
      "tertiary": "#D6BEE4", "onTertiary": "#3B2948",
      "tertiaryContainer": "#523F5F", "onTertiaryContainer": "#F0DBFF",
      "error": "#FFB4AB", "onError": "#690005",
      "errorContainer": "#93000A", "onErrorContainer": "#FFDAD6",
      "surface": "#101416", "onSurface": "#E2E2E6", "onSurfaceVariant": "#C1C7CE",
      "surfaceContainerLowest": "#101416", "surfaceContainerLow": "#171D22",
      "surfaceContainer": "#1B2329", "surfaceContainerHigh": "#1F2830",
      "surfaceContainerHighest": "#212A32",
      "outline": "#8B9198", "outlineVariant": "#41474D",
      "inverseSurface": "#E2E2E6", "onInverseSurface": "#2E3133"
    }
  },

  "gradient": {
    "page_frame_light_start": "#F2F6F9",
    "page_frame_light_end": "#EEF2F6",
    "_source": "TTMCS-001 :: 'UI page frames apply subtle dynamic linear gradients (#F2F6F9 to #EEF2F6) to minimize user reading strain.'"
  },

  "contrast_policy": {
    "_metric": "WCAG Colour Contrast Ratio -- TTMCS-005",
    "text_floor_ratio": 4.5,
    "text_optimal_ratio": 7.0,
    "non_text_floor_ratio": 3.0,
    "decorative_exempt": ["outlineVariant"],
    "decorative_exempt_rationale": "WCAG 2.1 SC 1.4.11 applies to graphical objects required to understand content. outlineVariant is MD3's decorative divider tint and is never the sole carrier of meaning; the meaning-bearing boundary token is 'outline', which is gated at 3.0:1."
  }
}
