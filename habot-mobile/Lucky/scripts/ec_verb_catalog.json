{
  "id": "PELCE-019-10",
  "title": "English Code (EC) System Verbs on Mobile CTAs",
  "version": "1.0.0",
  "standard": "DORA Change Failure Rate Metric",
  "description": "Master allowlist of machine-action verbs permitted on mobile button labels. CI linter rejects conversational or unauthorized verbs.",

  "allowedVerbs": [
    "add",
    "apply",
    "approve",
    "back",
    "cancel",
    "clear",
    "close",
    "confirm",
    "connect",
    "continue",
    "copy",
    "create",
    "delete",
    "disable",
    "dismiss",
    "download",
    "edit",
    "enable",
    "export",
    "filter",
    "go",
    "hide",
    "import",
    "install",
    "log",
    "next",
    "open",
    "pick",
    "refresh",
    "register",
    "reject",
    "release",
    "remove",
    "reset",
    "retry",
    "save",
    "search",
    "select",
    "send",
    "share",
    "show",
    "sign",
    "start",
    "stop",
    "submit",
    "sync",
    "update",
    "upload",
    "use",
    "verify",
    "view"
  ],

  "allowedPhrases": [
    "apply crop",
    "log in",
    "log out",
    "re-crop",
    "retrying",
    "sign in",
    "sign out",
    "submitting",
    "try again",
    "use face id / touch id",
    "verify code",
    "verify identity",
    "release to tech"
  ],

  "blockedPatterns": [
    "^click here",
    "^please\\b",
    "^let'?s\\b",
    "^ok\\b",
    "^sure\\b",
    "^thanks",
    "^got it",
    "^tap to",
    "^why don't",
    "^you can",
    "^learn more",
    "\\?$",
    "!$"
  ],

  "rules": {
    "maxWords": 4,
    "requireImperativeVerb": true,
    "exitCodeOnError": 1
  },

  "exemptFiles": [
    "router.dart",
    "error_fallback_screen.dart",
    "loading_button.dart"
  ],

  "buttonContextPattern": "FilledButton|ElevatedButton|OutlinedButton|TextButton|SubmitLockButton|HighRiskActionButton|ReleaseToTechButton|FilledButton\\.icon|OutlinedButton\\.icon|TextButton\\.icon|retryLabel:|loadingLabel:|actionLabel:|label:\\s*['\"]"
}
