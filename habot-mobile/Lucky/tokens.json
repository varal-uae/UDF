{
  "_meta": {
    "step": "TTMCS-016-A01",
    "title": "Design System Token Map — Primary Colors, Typography, Structural Elevations",
    "framework": "Material Design 3",
    "standard": "WCAG 2.1 AA",
    "grid": "8dp",
    "source": "HABOT Design System Reference Guide — AS-160826",
    "jurisdictions": ["Dubai", "India"],
    "themes": ["light", "dark"],
    "version": "v2",
    "status": "POPULATED — from HABOT Design System Reference Guide",
    "typeface": "Poppins / Inter (fallback: San Francisco, Segoe UI, sans-serif)",
    "compliance": {
      "wcag_contrast_aa": "4.5:1 minimum for normal text",
      "wcag_contrast_aa_large": "3:1 minimum for large text",
      "wcag_contrast_aaa": "7:1 for critical interface content",
      "touch_target": "48dp minimum (44dp floor, 56dp optimal)"
    }
  },

