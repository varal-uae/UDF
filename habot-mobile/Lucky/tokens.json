  "typography": {
    "_note": "Poppins/Inter official typeface. Weights: 400 Regular, 500 Medium, 700 Bold. Sizes in sp.",
    "font-family": {
      "primary":  "Poppins",
      "secondary": "Inter",
      "monospace": "monospace",
      "fallback":  "San Francisco, Segoe UI, sans-serif"
    },

    "weight": {
      "regular": 400,
      "medium":  500,
      "bold":    700
    },

    "scale": {
      "display-large":   { "font-family": "Poppins", "font-size": "57", "font-weight": "400", "line-height": "64", "letter-spacing": "-0.25" },
      "display-medium":  { "font-family": "Poppins", "font-size": "45", "font-weight": "400", "line-height": "52", "letter-spacing": "0" },
      "display-small":   { "font-family": "Poppins", "font-size": "36", "font-weight": "400", "line-height": "44", "letter-spacing": "0" },

      "headline-large":  { "font-family": "Poppins", "font-size": "32", "font-weight": "400", "line-height": "40", "letter-spacing": "0" },
      "headline-medium": { "font-family": "Poppins", "font-size": "28", "font-weight": "400", "line-height": "36", "letter-spacing": "0" },
      "headline-small":  { "font-family": "Poppins", "font-size": "24", "font-weight": "400", "line-height": "32", "letter-spacing": "0" },

      "title-large":     { "font-family": "Poppins", "font-size": "22", "font-weight": "500", "line-height": "28", "letter-spacing": "0" },
      "title-medium":    { "font-family": "Poppins", "font-size": "16", "font-weight": "500", "line-height": "24", "letter-spacing": "0.15" },
      "title-small":     { "font-family": "Poppins", "font-size": "14", "font-weight": "500", "line-height": "20", "letter-spacing": "0.1" },

      "body-large":      { "font-family": "Inter",   "font-size": "16", "font-weight": "400", "line-height": "24", "letter-spacing": "0.5" },
      "body-medium":     { "font-family": "Inter",   "font-size": "14", "font-weight": "400", "line-height": "20", "letter-spacing": "0.25" },
      "body-small":      { "font-family": "Inter",   "font-size": "12", "font-weight": "400", "line-height": "16", "letter-spacing": "0.4" },

      "label-large":     { "font-family": "Inter",   "font-size": "14", "font-weight": "500", "line-height": "20", "letter-spacing": "0.1" },
      "label-medium":    { "font-family": "Inter",   "font-size": "12", "font-weight": "500", "line-height": "16", "letter-spacing": "0.5" },
      "label-small":     { "font-family": "Inter",   "font-size": "11", "font-weight": "500", "line-height": "16", "letter-spacing": "0.5" }
    },

    "monospace": {
      "font-family": "monospace",
      "font-size":   "14",
      "font-weight": "500",
      "letter-spacing": "0.3",
      "use": "Account numbers, transaction IDs, hash values, codes"
    },

    "viewport-scale": {
      "mobile":  { "breakpoint-max-dp": "600",  "scale-factor": "1.0" },
      "tablet":  { "breakpoint-min-dp": "600",  "breakpoint-max-dp": "1200", "scale-factor": "1.05" },
      "desktop": { "breakpoint-min-dp": "1200", "scale-factor": "1.1" }
    }
  },

  "spacing": {
    "_note": "6 approved spacing sizes. All values in dp. Extra small = 4, Small = 8, Medium = 16, Large = 24, Extra Large = 32, 2XL = 48.",
    "xs":  "4",
    "sm":  "8",
    "md":  "16",
    "lg":  "24",
    "xl":  "32",
    "2xl": "48",
    "3xl": "64"
  },

  "radius": {
    "_note": "Corner radius scale from HABOT Design System Ch.2.5",
    "none":   "0",
    "xs":     "4",
    "sm":     "8",
    "md":     "12",
    "lg":     "16",
    "xl":     "24",
    "full":   "999"
  },

  "elevation": {
    "_note": "6 elevation levels from HABOT Design System Ch.2.4. Shadow values pending Figma export.",
    "level0": { "dp": "0",  "shadow-color": "#000000", "shadow-opacity": "0" },
    "level1": { "dp": "1",  "shadow-color": "#000000", "shadow-opacity": "0.05" },
    "level2": { "dp": "3",  "shadow-color": "#000000", "shadow-opacity": "0.08" },
    "level3": { "dp": "6",  "shadow-color": "#000000", "shadow-opacity": "0.11" },
    "level4": { "dp": "8",  "shadow-color": "#000000", "shadow-opacity": "0.14" },
    "level5": { "dp": "12", "shadow-color": "#000000", "shadow-opacity": "0.18" }
  },

  "grid": {
    "_note": "Breakpoints and grid from HABOT Design System Ch.3",
    "mobile":       { "min-width": "360", "columns": "4",  "margin": "16", "gutter": "8" },
    "tablet":       { "min-width": "600", "columns": "8",  "margin": "24", "gutter": "16" },
    "tablet-large": { "min-width": "840", "columns": "12", "margin": "24", "gutter": "24" },
    "desktop":      { "min-width": "1200","columns": "12", "margin": "32", "gutter": "24" }
  },

  "touch": {
    "_note": "Touch target standards from HABOT Design System Ch.11",
    "minimum":    "44",
    "comfortable": "48",
    "spacious":   "56"
  },

  "component": {
    "button": {
      "height":              "48",
      "min-width":           "48",
      "padding-vertical":    "12",
      "padding-horizontal":  "24",
      "border-radius":       "8",
      "gap-between":         "8",
      "label-style":         "label-large",
      "filled": {
        "background":             "primary",
        "on-background":          "#FFFFFF",
        "disabled-opacity":       "0.38"
      },
      "outlined": {
        "border-width":           "1",
        "border-color":           "outline",
        "on-background":          "primary",
        "disabled-opacity":       "0.38"
      },
      "tonal": {
        "background":             "secondary-container",
        "on-background":          "on-secondary-container"
      },
      "elevated": {
        "elevation":              "1",
        "background":             "surface",
        "on-background":          "on-surface"
      },
      "text": {
        "on-background":          "primary",
        "disabled-opacity":       "0.38"
      }
    },

    "card": {
      "border-radius":   "12",
      "padding":         "16",
      "elevation-resting": "1",
      "elevation-hover":   "2",
      "scale-on-press":  "0.98",
      "press-duration-ms": "150",
      "surface-color":   "surface-container-lowest",
      "outline-width":   "1"
    },

    "input-field": {
      "height":               "56",
      "border-radius":        "8",
      "padding-horizontal":   "16",
      "border-width":         "1",
      "focused-border-width": "2",
      "label-style":          "body-large",
      "body-style":           "body-large",
      "error-border-color":   "#E31B23"
    },

    "navigation-bar": {
      "height":        "80",
      "max-items":     "5",
      "tap-target":    "48",
      "border-top":    "1",
      "surface-color": "surface",
      "label-style":   "label-medium"
    },

    "app-bar": {
      "height":       "56",
      "surface-color": "surface",
      "elevation":    "0",
      "title-style":  "title-large"
    },

    "chip": {
      "height":        "32",
      "border-radius": "8",
      "label-style":   "label-large"
    },

    "dialog": {
      "border-radius": "28",
      "padding":       "24",
      "elevation":     "3",
      "title-style":   "headline-small",
      "body-style":    "body-medium"
    },

    "bottom-sheet": {
      "border-radius-top": "16",
      "padding":           "16",
      "elevation":         "2",
      "handle-width":      "32",
      "handle-height":     "4",
      "handle-radius":     "2"
    },

    "toggle-switch": {
      "track-width":   "52",
      "track-height":  "32",
      "disabled-opacity": "0.38"
    },

    "stepper": {
      "blocked-opacity": "0.4",
      "connector-width": "2"
    }
  },

  "container": {
    "mobile": {
      "max-width":          "600",
      "padding-horizontal": "16",
      "padding-vertical":   "16"
    },
    "tablet": {
      "max-width":          "840",
      "padding-horizontal": "24",
      "padding-vertical":   "24"
    },
    "desktop": {
      "max-width":          "1200",
      "padding-horizontal": "32",
      "padding-vertical":   "32"
    }
  },

  "motion": {
    "_note": "MD3 motion system. Standard, Emphasized, Decelerated, Accelerated.",
    "duration": {
      "short1":  "50",
      "short2":  "100",
      "short3":  "150",
      "short4":  "200",
      "medium1": "250",
      "medium2": "300",
      "long1":   "350",
      "long2":   "400"
    },
    "easing": {
      "standard":              "cubic-bezier(0.2, 0, 0, 1)",
      "standard-decelerate":   "cubic-bezier(0, 0, 0, 1)",
      "standard-accelerate":   "cubic-bezier(0.3, 0, 1, 1)",
      "emphasized":            "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "emphasized-accelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    }
  },

  "ai-confidence": {
    "_note": "Three-tier AI confidence colour coding from HABOT Design System Ch.5.8",
    "high":   { "threshold": "0.90", "meaning": "High reliability — auto-approve enabled",    "color": "#21B373" },
    "medium": { "threshold": "0.70", "meaning": "Acceptable — proceed with caution",           "color": "#FF9800" },
    "low":    { "threshold": "0.00", "meaning": "Unreliable — requires human intervention",   "color": "#E31B23" }
  },

  "performance": {
    "_note": "Mobile-first performance budgets from HABOT Design System Ch.11",
    "budget": {
      "javascript-kb": "150",
      "css-kb":        "50",
      "images-kb":     "200",
      "fonts-kb":      "40",
      "total-kb":      "400"
    }
  }
}
