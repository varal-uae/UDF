    "status": {
      "_note": "Fully defined from HABOT Design System Reference Guide",
      "success": {
        "container": "#C6E8D9",
        "main":      "#21B373",
        "dark":      "#086C44",
        "on-color":  "#FFFFFF"
      },
      "error": {
        "container": "#F9DEDC",
        "main":      "#E31B23",
        "dark":      "#8B0811",
        "on-color":  "#FFFFFF"
      },
      "warning": {
        "container": "#FFE0B2",
        "main":      "#FF9800",
        "dark":      "#E65100",
        "on-color":  "#000000"
      },
      "info": {
        "container": "#D1E7F7",
        "main":      "#1976D2",
        "dark":      "#0D47A1",
        "on-color":  "#FFFFFF"
      }
    },

    "neutral": {
      "primary-surface":   "#FFFBFE",
